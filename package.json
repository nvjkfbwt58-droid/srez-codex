{
  "name": "srez-codex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node dist-server/index.js",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "check": "npm run test && npm run build",
    "test:e2e": "playwright test",
    "build:pages": "tsc --noEmit && vite build --mode pages && node scripts/prepare-pages.mjs",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 5180"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.8.2",
    "motion": "12.23.12",
    "lucide-react": "0.542.0",
    "@tanstack/react-table": "8.21.3",
    "zustand": "5.0.8",
    "zod": "4.1.5",
    "express": "5.1.0",
    "multer": "2.0.2",
    "openai": "6.2.0",
    "sharp": "0.34.3",
    "html-to-image": "1.11.13",
    "qrcode": "1.5.4",
    "papaparse": "5.5.3",
    "idb-keyval": "6.2.2",
    "@fontsource/inter": "5.2.6",
    "dotenv": "17.2.2",
    "pdfjs-dist": "5.4.149",
    "@napi-rs/canvas": "0.1.80"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "7.1.4",
    "@vitejs/plugin-react": "5.0.2",
    "tsx": "4.20.5",
    "concurrently": "9.2.1",
    "esbuild": "0.25.9",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/node": "24.3.0",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/qrcode": "1.5.5",
    "@types/papaparse": "5.3.16",
    "@playwright/test": "1.55.0"
  }
}

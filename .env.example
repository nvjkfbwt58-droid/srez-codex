# No secrets in this example. For an isolated audit, follow AUDIT-HANDOFF.md.
# DATA_DIR must point to the NEW temporary directory made by scripts/audit-seed.ts.
# IMAGE_PROVIDER=none disables external AI, even when a shell already has a key.
OPENAI_API_KEY=
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-2.5-sunburst
BRAND_ANALYSIS_MODEL=gpt-4.1
PORT=4178
DATA_DIR=./storage
MAX_JOBS_PER_DAY=20
MAX_CONCURRENT_JOBS=2
